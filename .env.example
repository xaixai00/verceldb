# Copy these into Vercel → Project → Settings → Environment Variables.
# (Never commit real values.)

# Turso database URL, from: turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://jcs-motorparts-<your-org>.turso.io

# Turso auth token, from: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=

# Password for https://<your-site>/admin  (use a long, unique one)
ADMIN_PASSWORD=
