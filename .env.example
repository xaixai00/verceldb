# Copy these into Vercel → Project → Settings → Environment Variables.
# (Never commit real values.)

# Turso database URL, from: turso db show <db-name> --url
TURSO_DATABASE_URL=libsql://jcs-motorparts-<your-org>.turso.io

# Turso auth token, from: turso db tokens create <db-name>
TURSO_AUTH_TOKEN=

# Password for https://<your-site>/admin  (use a long, unique one)
ADMIN_PASSWORD=

# Optional: "I'm not a robot" check on sign-in (Cloudflare Turnstile, free).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# and add your Vercel domain. Set BOTH, or leave both empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: "Forgot password?" emails a 6-digit code (Brevo, free tier).
# BREVO_API_KEY: Brevo -> SMTP & API -> API Keys. MAIL_FROM must be a sender
# you verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
# Set BOTH, or leave empty to hide the "Forgot password?" link.
BREVO_API_KEY=
MAIL_FROM=
# MAIL_FROM_NAME=JCS MotorParts
